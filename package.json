{
  "name": "misskey-instance-list",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @mil/core build && concurrently --kill-others --names \"Core,Agent,Web\" -c \"gray,magenta,cyan\" \"pnpm dev:core\" \"pnpm dev:agent\" \"pnpm dev:web\"",
    "dev:core": "pnpm --filter @mil/core dev",
    "dev:agent": "pnpm --filter @mil/agent dev",
    "dev:web": "pnpm --filter @mil/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @mil/core db:generate",
    "db:migrate": "pnpm --filter @mil/core db:migrate:deploy",
    "db:migrate:stg": "pnpm --filter @mil/core db:migrate:stg",
    "db:migrate:local": "pnpm --filter @mil/core db:migrate:local",
    "jobs:migrate": "pnpm --filter @mil/agent jobs:migrate:deploy",
    "jobs:migrate:stg": "pnpm --filter @mil/agent jobs:migrate:stg",
    "jobs:migrate:local": "pnpm --filter @mil/agent jobs:migrate:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
