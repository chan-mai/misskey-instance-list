# --- agent ---

# タスク手動起動を認証するシークレット。
# 本番はwrangler secret putで設定する (このファイルの値はローカル用)
TASK_SECRET=your-secret-key-here

# GitHub APIのレート制限緩和用, 未設定でも動くが未認証枠になる
GITHUB_TOKEN=

# --- web ---

# ZITADEL (OIDC)
NUXT_OIDC_PROVIDERS_ZITADEL_BASE_URL=https://your-instance.zitadel.cloud
NUXT_OIDC_PROVIDERS_ZITADEL_CLIENT_ID=
NUXT_OIDC_PROVIDERS_ZITADEL_CLIENT_SECRET=
NUXT_OIDC_PROVIDERS_ZITADEL_REDIRECT_URI=http://localhost:3000/auth/zitadel/callback

# セッション用シークレット, 未設定だと起動ごとにランダム生成されセッションが切れる
# NUXT_OIDC_SESSION_SECRET: 48文字以上
#   openssl rand -hex 32
# NUXT_OIDC_TOKEN_KEY: AES-256キーのbase64
#   openssl rand -base64 32
# NUXT_OIDC_AUTH_SESSION_SECRET: 48文字以上
#   openssl rand -hex 32
NUXT_OIDC_SESSION_SECRET=
NUXT_OIDC_TOKEN_KEY=
NUXT_OIDC_AUTH_SESSION_SECRET=
