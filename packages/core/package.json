{
  "name": "@mil/core",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./db": "./dist/db/index.js",
    "./crawl": "./dist/crawl/index.js",
    "./net": "./dist/net/index.js"
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "eld": "^2.0.3",
    "franc": "^6.2.0",
    "ipaddr.js": "^2.4.0",
    "iso-639-3": "^3.0.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
