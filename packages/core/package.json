{
  "name": "@mil/core",
  "type": "module",
  "private": true,
  "exports": {
    "./entity": "./dist/entity/index.js",
    "./db": "./dist/db/index.js",
    "./repository": "./dist/repository/index.js",
    "./client": "./dist/client/index.js",
    "./domain": "./dist/domain/index.js",
    "./lang": "./dist/lang/index.js",
    "./net": "./dist/net/index.js",
    "./validation": "./dist/validation/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "wrangler d1 migrations apply misskey-instance-list-prod --remote --env prod",
    "db:migrate:stg": "wrangler d1 migrations apply misskey-instance-list-stg --remote --env stg",
    "db:migrate:local": "wrangler d1 migrations apply misskey-instance-list --local --persist-to ../../.wrangler/state",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "eld": "^2.1.0",
    "franc": "^6.2.0",
    "ipaddr.js": "^2.5.0",
    "iso-639-3": "^3.0.1",
    "js-yaml": "^5.5.0",
    "tinyld": "^1.3.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
