{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misskey-instance-list",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true },

  // 既定はローカル開発用
  "d1_databases": [{ "binding": "DB", "database_name": "misskey-instance-list" }],
  "kv_namespaces": [{ "binding": "CACHE_KV" }],

  "env": {
    "stg": {
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true },
      "assets": { "directory": "./.output/public/", "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "misskey-instance-list-stg",
          "database_id": "aa47f9b6-8bbd-4b75-92a1-8e180884cea6"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "4c8eb42e4a8c463ba7c679d41d3d8edd" }],
      // client_idはOIDC仕様上の公開値, 秘匿対象はclient_secretのみ
      "vars": {
        "NUXT_OIDC_PROVIDERS_ZITADEL_REDIRECT_URI": "https://servers-stg.misskey.ink/auth/zitadel/callback",
        "NUXT_OIDC_PROVIDERS_ZITADEL_CLIENT_ID": "382500899836169407"
      },
      // DNS切替前の確認用にworkers.devも開けておく
      "workers_dev": true,
      "routes": [{ "pattern": "servers-stg.misskey.ink", "custom_domain": true }]
    },
    "prod": {
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true },
      "assets": { "directory": "./.output/public/", "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "misskey-instance-list-prod",
          "database_id": "d0bf79de-822f-4c76-9b4d-c409a06d77aa"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "966e372ff50f41c8b1bb626c81384b3f" }],
      "vars": {
        "NUXT_OIDC_PROVIDERS_ZITADEL_REDIRECT_URI": "https://servers.misskey.ink/auth/zitadel/callback",
        "NUXT_OIDC_PROVIDERS_ZITADEL_CLIENT_ID": "382502852452453567"
      }
      // prodのcustom_domainは意図的に未設定, 切替は手動で行う
    }
  }
}
