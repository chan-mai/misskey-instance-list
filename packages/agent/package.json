{
  "name": "@mil/agent",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @mil/core build",
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "jobs:migrate:local": "wrangler d1 migrations apply misskey-instance-list-jobs --local --persist-to ../../.wrangler/state",
    "jobs:migrate:stg": "wrangler d1 migrations apply misskey-instance-list-jobs-stg --remote --env stg",
    "jobs:migrate:deploy": "wrangler d1 migrations apply misskey-instance-list-jobs-prod --remote --env prod"
  },
  "dependencies": {
    "@mil/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "js-yaml": "^4.3.1",
    "tsumugi": "0.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
