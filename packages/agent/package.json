{
  "name": "@mil/agent",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "maintenance": "tsx --env-file-if-exists=../../.env scripts/maintenance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.2.2",
    "@hono/node-server": "^1.15.0",
    "@mil/core": "workspace:*",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
